工作/
创作/
灵感/
助手/
报告/
系统/
.trash/
plugin-data/
*.bak

# 本地配置（含社区地址等个人设置）
.env
.env.*
社区.json

# 编辑器与系统
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
