{
  "name": "dsh-secretary",
  "version": "0.14.0",
  "description": "知微观澜：把工作、创作、灵感记录成 Markdown，按空闲时段分析，每天固定时间提醒。",
  "license": "MIT",
  "author": "熊博明",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xboming/dsh-secretary.git"
  },
  "homepage": "https://github.com/xboming/dsh-secretary#readme",
  "bugs": {
    "url": "https://github.com/xboming/dsh-secretary/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "markdown",
    "notes",
    "reminder"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "icon": "icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
